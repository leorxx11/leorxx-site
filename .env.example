# 复制成 .env 再填

# 页面所在的源，桌面页面在它的 /desk 下；本地调试用 http://localhost:3100
ORIGIN=https://leorxx.xyz
# 图片链接用的源（上传的文件和主站分开）；本地调试时删掉这一行
IMAGE_ORIGIN=https://img.leorxx.xyz
# 通行密钥绑定的域名，默认取 ORIGIN 的域名；改了以后已经绑定的通行密钥就不能用了。本地调试时删掉这一行
RP_ID=leorxx.xyz
# 登录有效期（天），每天第一次访问自动续期
# SESSION_DAYS=365

# Cloudflare R2：控制台 → R2 → 管理 API 令牌（Account 令牌，「对象读和写」，只限这个桶）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pic

# 单张图片上限、其他文件上限（MB）、回收站保留天数
# 改大了记得同步 Caddyfile 里的 request_body max_size
MAX_MB=20
MAX_FILE_MB=100
TRASH_DAYS=30

# 主页「目录」里的在线检测，由本服务在服务器端探测（名字=地址，逗号分隔）
STATUS_TARGETS=tz=https://tz.leorxx.xyz,st=https://st.leorxx.xyz,ci=https://ci.leorxx.xyz
