# 追加在服务器 /opt/komari-server/Caddyfile 末尾（caddy 容器里是 /etc/caddy/Caddyfile）
# 主页和桌面由同一个 darkroom 容器提供，Caddy 只负责 HTTPS、压缩和转发；图片单独走 img.leorxx.xyz

leorxx.xyz {
	encode zstd gzip

	request_body {
		max_size 105MB
	}
	reverse_proxy darkroom:3100
}

www.leorxx.xyz {
	redir https://leorxx.xyz{uri} permanent
}

# 只负责出图和文件；其他地址都转到 leorxx.xyz/desk
# /sw.js 由后端返回一个自我注销的脚本，清掉以前单独装在这个域名上的 Service Worker
img.leorxx.xyz {
	@served path /i/* /sw.js
	handle @served {
		reverse_proxy darkroom:3100
	}
	handle {
		redir https://leorxx.xyz/desk 302
	}
}
