# 复制成 .env 再填
PORT=3100
HOST=127.0.0.1

# 上传口令，至少 12 位。生成一个：openssl rand -base64 24
UPLOAD_TOKEN=

# Cloudflare R2：控制台 → R2 → 管理 API 令牌（权限选「对象读和写」，限定到这个桶）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pic

# 图片对外地址前缀。默认 /i 表示由本服务转发（img.leorxx.xyz/i/...）
# 以后给桶绑了自定义域，就改成比如 https://i.leorxx.xyz
PUBLIC_BASE=/i

# 单张上限（MB）
MAX_MB=20

# 主页「目录」里的在线检测，由本服务在服务器端探测（名字=地址，逗号分隔）
STATUS_TARGETS=tz=https://tz.leorxx.xyz,st=https://st.leorxx.xyz,ci=https://ci.leorxx.xyz
