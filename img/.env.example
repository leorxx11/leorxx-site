# 复制成 .env 再填

# 页面所在的源，暗房页面在它的 /darkroom 下；本地调试用 http://localhost:3100
ORIGIN=https://leorxx.xyz
# 图片链接用的源（上传的内容和要登录的页面分开）；本地调试时删掉这一行
IMAGE_ORIGIN=https://img.leorxx.xyz
# 通行密钥绑定的域名，用上级域名，以后其他子域名也能复用
RP_ID=leorxx.xyz

# Cloudflare R2：控制台 → R2 → 管理 API 令牌（Account 令牌，「对象读和写」，只限这个桶）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pic

# 单张上限（MB）、废纸篓保留天数
MAX_MB=20
TRASH_DAYS=30

# 主页「目录」里的在线检测，由本服务在服务器端探测（名字=地址，逗号分隔）
STATUS_TARGETS=tz=https://tz.leorxx.xyz,st=https://st.leorxx.xyz,ci=https://ci.leorxx.xyz
